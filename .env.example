# Root-level environment variables (docker-compose 용)
# Copy this file to .env and fill values.

# Docker images
# COMPOSE_PROJECT_NAME=my-app

# Ports (host)
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80

# Database (if used)
# POSTGRES_USER=app
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=app
# POSTGRES_PORT=5432

# Redis (if used)
# REDIS_PORT=6379
