# Backend environment variables
# Copy this file to .env and fill values.

# Environment
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Database (if used)
# DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://app:password@db:5432/app

# Secrets — change in production
SECRET_KEY=change-this-secret-key

# ============================================================
# LLM (OpenAI-compatible 또는 Azure OpenAI)
# ⚠️ 외부 API (api.anthropic.com, api.openai.com) 호출 금지 — LG 사내 endpoint 만.
# ============================================================
# Provider:
#   openai_compatible (기본) — Ollama / vLLM / LG OpenAI 호환 게이트웨이
#   azure                    — LG 사내 Azure OpenAI (https://*.openai.azure.com)
LLM_PROVIDER=openai_compatible

# 개발 (로컬 Ollama, RTX 4090) — 현재 셋업
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-or-internal-key
# 로컬: exaone3.5:7.8b (LG 자체 모델, 한국어 우수, GPU 8GB+)
# CPU only PC: qwen2.5:3b-instruct
LLM_MODEL=exaone3.5:7.8b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0

# ── Azure OpenAI 전환 시 (LG 사내망) ──────────────────────────
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://<resource-name>.openai.azure.com
# LLM_API_KEY=<azure-api-key>
# LLM_MODEL=<deployment-name>            # ⚠ 실제 모델 ID 아님. Azure 에서 만든 deployment 이름.
# LLM_API_VERSION=2024-08-01-preview     # Azure 안정 버전. LG 가이드에 명시된 값으로 덮어쓰기.

# ============================================================
# Demo mode — AWS EC2 등 LLM 없는 환경 배포용
# ============================================================
# true 면 LLM 호출 자체 skip. backend/mock_narratives/{period_id}.json 있으면 재생,
# 없으면 각 함수 안의 template fallback 자동 적용. 외부 의존 zero.
# 운영(LG 내부망) 전환 시 false 또는 줄 자체 제거.
DEMO_MODE=false
# record 스크립트 실행 시에만 true (라이브 LLM 결과를 JSON 으로 저장)
RECORD_NARRATIVES=false

# ============================================================
# Database (사내 PostgreSQL 또는 로컬 SQLite)
# ============================================================
# DATABASE_URL=postgresql+psycopg2://app:password@db:5432/lg_kitchen_agent
DATABASE_URL=sqlite:///./app.db

# ============================================================
# Mail ingestion (이메일 인프라 확정 후 채움)
# ============================================================
# MS Graph (Outlook/Exchange) — 권장
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MAIL_USER=performance-reports@lge.example
#
# 또는 IMAP
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
