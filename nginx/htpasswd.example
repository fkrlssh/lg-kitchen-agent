# Sample only — DO NOT commit a real htpasswd file.
# 실제 nginx/htpasswd 는 .gitignore 에 들어가 있음.
#
# 생성 방법 (호스트에 apache2-utils 가 없어도 docker 한 줄로):
#   docker run --rm httpd:alpine htpasswd -nbB demo "YOUR_PASSWORD" > nginx/htpasswd
#
# 또는 Ubuntu:
#   sudo apt-get install -y apache2-utils
#   htpasswd -cBb nginx/htpasswd demo "YOUR_PASSWORD"
#
# 여러 사용자 추가:
#   docker run --rm httpd:alpine htpasswd -nbB lg "ANOTHER_PASSWORD" >> nginx/htpasswd
#
# 형식 (참고용 placeholder — 실제 hash 아님):
# demo:$2y$05$placeholder.placeholder.placeholder.placeholder.placeholder.placeholder
